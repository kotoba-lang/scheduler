{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/scheduler — durable tick scheduler. Layered on the kotoba-lang
 ;; foundational stdlib; consumes async (bounded ready-queue), time (clock +
 ;; intervals), coll (job shaping). A real consumer of those three libs (M5
 ;; for async/time/coll). No third-party deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        io.github.kotoba-lang/scheduler-at
        {:git/url "https://github.com/kotoba-lang/scheduler-at.git"
         :git/sha "1eaa17ce3e7fa5bca5858b3fec227b12e831a5af"}
        io.github.kotoba-lang/scheduler-cancel
        {:git/url "https://github.com/kotoba-lang/scheduler-cancel.git"
         :git/sha "12fe2f7dbd92199cc988f416ff2f46062760f7c2"}
        io.github.kotoba-lang/scheduler-due
        {:git/url "https://github.com/kotoba-lang/scheduler-due.git"
         :git/sha "1e9dfeedaf1a97aa468d90d1d253f205084a0151"}
        io.github.kotoba-lang/scheduler-every
        {:git/url "https://github.com/kotoba-lang/scheduler-every.git"
         :git/sha "5381aba085da775e26e23d00ef61b73aeb48476e"}
        io.github.kotoba-lang/scheduler-scheduler
        {:git/url "https://github.com/kotoba-lang/scheduler-scheduler.git"
         :git/sha "bc5a9311431279404791d2b4f399547d4d6fd2bc"}
        io.github.kotoba-lang/scheduler-tick
        {:git/url "https://github.com/kotoba-lang/scheduler-tick.git"
         :git/sha "f9c2e743219d4488800eb6cbc7e424fc534fadf3"}
io.github.kotoba-lang/async {:git/sha "710e342414924910e132272ff0862892a14a4fc6"}
        io.github.kotoba-lang/time   {:git/sha "c5bca3c4f0f40b8a75aa6917213868a5d2e5ac43"}
        io.github.kotoba-lang/coll   {:git/sha "9740cc2dc43a192077d77374b869a37940c801e4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
